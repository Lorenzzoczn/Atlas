# URL pública da API do Atlas, com o prefixo de versão incluído.
# Local:      http://localhost:3333/api/v1
# Produção:   https://api.seudominio.com/api/v1
#
# NEXT_PUBLIC_* é embutido no bundle em tempo de build: mudar exige rebuild,
# e o valor fica visível no navegador — nunca coloque segredo aqui.
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
